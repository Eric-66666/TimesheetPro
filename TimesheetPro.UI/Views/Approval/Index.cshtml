@model IEnumerable<TimesheetEntry>

@{
    ViewData["Title"] = "Approvals";
}

<div class="container">

    <h2>Pending Approvals</h2>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.WorkDate)</th>
                <th>Consultant</th>
                <th>@Html.DisplayNameFor(m => m.Project)</th>
                <th>@Html.DisplayNameFor(m => m.Hours)</th>
                <th>@Html.DisplayNameFor(m => m.Description)</th>
                <th style="width:15%;"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.WorkDate.ToString("yyyy-MM-dd")</td>
                    <td>@(item.User?.FullName ?? item.User?.Email)</td>
                    <td>@item.Project?.Name</td>
                    <td>@item.Hours</td>
                    <td>@item.Description</td>
                    <td class="d-flex justify-content-end align-items-center">
                        <form asp-controller="Approval" asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline me-2">
                            <button type="submit" class="btn btn-outline-success">Approve</button>
                        </form>

                        <form asp-controller="Approval" asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-secondary">No submitted timesheets for approval.</p>
    }

</div>