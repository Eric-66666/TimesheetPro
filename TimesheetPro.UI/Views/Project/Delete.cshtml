@model Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container">
    <h2>Delete Project</h2>

    <p>Are you sure you want to delete this project?</p>

    <form asp-controller="Project" asp-action="Delete" method="post">

        <input asp-for="Id" type="hidden"/>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" type="text" class="form-control" disabled/>
        </div>

        <div class="mb-3">
            <label asp-for="ClientName" class="form-label"></label>
            <input asp-for="ClientName" type="text" class="form-control" disabled/>
        </div>

        <div class="mb-3">
            <label asp-for="BudgetHours" class="form-label"></label>
            <input asp-for="BudgetHours" type="number" class="form-control" disabled/>
        </div>


        <div class="d-flex justify-content-between align-items-center mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-controller="Project" asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </form>
</div>