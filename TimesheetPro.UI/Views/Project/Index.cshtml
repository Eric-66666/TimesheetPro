@model IEnumerable<Project>

@{
    ViewData["Title"] = "Projects";
}



<div class="container">


    @* deletion message *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }



    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Projects</h2>

        @if(User.IsInRole(nameof(AppRoles.ProjectManager)))
        {
            <a asp-controller="Project" asp-action="Create" class="btn btn-primary">Create New Project</a>
        }
        
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>@Html.DisplayNameFor(m => m.ClientName)</th>
                <th>@Html.DisplayNameFor(m => m.BudgetHours)</th>
                <th>@Html.DisplayNameFor(m => m.StartDate)</th>
                <th>@Html.DisplayNameFor(m => m.EndDate)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ClientName</td>
                    <td>@item.BudgetHours</td>
                    <td>@item.StartDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.EndDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        
                        @if (User.IsInRole(nameof(AppRoles.ProjectManager)))
                        {
                            <div class="d-flex justify-content-end align-items-center">
                                <a asp-controller="Project" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                                <a asp-controller="Project" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger ms-2">Delete</a>         
                            </div>
                        }
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-secondary">No projects yet. Click button to create one.</p>
    }

</div>