@model TimesheetEntry

@{
    ViewData["Title"] = "Edit Timesheet";
    var projects = ViewBag.Projects as List<Project>;
}

<div class="container">

    <h2>Edit Timesheet</h2>

    <form asp-controller="Timesheet" asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden"/>

        <div class="mb-3">
            <label asp-for="WorkDate" class="form-label"></label>
            <input asp-for="WorkDate" type="date" class="form-control" />
            <span asp-validation-for="WorkDate" class="text-danger"></span>
        </div>


        @* drop-down list *@
        <div class="mb-3">
            <label asp-for="ProjectId" class="form-label">Project</label>
            <select asp-for="ProjectId" class="form-select">
                <option value="">-- Select project --</option>
                @if (projects != null)
                {
                    foreach (var project in projects)
                    {
                        <option value="@project.Id" selected="@(project.Id == Model.ProjectId)">
                            @project.Name (Client: @project.ClientName)
                        </option>
                    }
                }
            </select>
            <span asp-validation-for="ProjectId" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Hours" class="form-label"></label>
            <input asp-for="Hours" type="number" class="form-control" />
            <span asp-validation-for="Hours" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button type="submit" class="btn btn-primary">Edit</button>
            <a asp-controller="Timesheet" asp-action="MyTimesheet" class="btn btn-secondary">Back</a>
        </div>

    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}