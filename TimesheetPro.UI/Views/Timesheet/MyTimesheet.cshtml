@model IEnumerable<TimesheetEntry>

@{
    ViewData["Title"] = "My Timesheets";
}

@functions{
    string GetBadgeClass(TimesheetStatus status)
    {
        return status switch
        {
            TimesheetStatus.Draft => "bg-secondary",
            TimesheetStatus.Submitted => "bg-primary",
            TimesheetStatus.Approved => "bg-success",
            TimesheetStatus.Rejected => "bg-danger",
            _ => "bg-light"
        };
    }
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Timesheets</h2>

        <a asp-controller="Timesheet" asp-action="Create" class="btn btn-primary">Create New Timesheet</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.WorkDate)</th>
                <th>@Html.DisplayNameFor(m => m.Project)</th>
                <th>@Html.DisplayNameFor(m => m.Hours)</th>
                <th>@Html.DisplayNameFor(m => m.Status)</th>
                <th>@Html.DisplayNameFor(m => m.Description)</th>
                <th style="width:15%;"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.WorkDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Project?.Name</td>
                    <td>@item.Hours</td>
                    <td>
                        <span class="badge @GetBadgeClass(item.Status)">@item.Status</span>
                    </td>
                    <td>@item.Description</td>
                    <td>
                        @if (item.Status == TimesheetStatus.Draft)
                        {
                            <div class="d-flex justify-content-end align-items-center">
                                <a asp-controller="Timesheet" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary me-2">
                                    Edit
                                </a>

                                <form asp-controller="Timesheet" asp-action="Submit" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-success">Submit</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-secondary">No timesheets yet. Click button to create one.</p>
    }

</div>

